<style>
/* ============================================
   FIX HERO CONTENT BEHIND FIXED NAV
   ============================================ */

/* Desktop - account for nav height */
.hero,
body > section:first-of-type,
main > section:first-of-type {
  padding-top: 5rem !important; /* Adjust based on your nav height */
}

/* Mobile - account for smaller nav */
@media (max-width: 767px) {
  .hero,
  body > section:first-of-type,
  main > section:first-of-type {
    padding-top: 4rem !important; /* Nav height on mobile (~72px) + some spacing */
  }
  
  /* If your nav has a specific class, target it more specifically */
  .hero {
    margin-top: 0 !important;
    padding-top: 4.5rem !important; /* About 72px for nav */
  }
}

@media (max-width: 479px) {
  .hero {
    padding-top: 4rem !important; /* Slightly less on very small screens */
  }
}

/* Alternative: Add padding to body to push ALL content down */
body {
  padding-top: 80px; /* Desktop nav height */
}

@media (max-width: 767px) {
  body {
    padding-top: 72px !important; /* Mobile nav height */
  }
}
</style>


