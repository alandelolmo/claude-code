<style>
/* Just the hero background */
.hero {
  background: linear-gradient(135deg, #14B8A6 0%, #0F766E 100%) !important;
  color: white !important;
}

.hero * {
  color: white !important;
}

.hero .btn--primary {
  background-color: white !important;
  color: #0F766E !important;
}

.hero .btn--secondary {
  border-color: white !important;
  color: white !important;
}
</style>


<style>
/* ============================================
   HERO SECTION - DUAL THEME SUPPORT
   ============================================ */

/* LIGHT MODE (Default) */
.hero.section--dark {
  background: #FFFFFF !important;
  color: #111827 !important;
  min-height: 80vh;
  display: flex;
  align-items: center;
}

/* Hero text elements - Light mode */
.hero .hero-heading {
  color: #111827 !important;
}

.hero .hero-subtitle {
  color: #6B7280 !important;
}

/* Primary button - Light mode (teal background) */
.hero .btn--primary {
  background-color: #14B8A6 !important;
  color: white !important;
  border-color: #14B8A6 !important;
}

.hero .btn--primary * {
  color: white !important;
}

/* Secondary button - Light mode (outlined, DARK text) */
.hero .btn--secondary {
  background-color: transparent !important;
  color: #111827 !important;
  border-color: #E5E7EB !important;
}

/* Force ALL child elements in secondary button to be dark */
.hero .btn--secondary *,
.hero .btn--secondary span,
.hero .btn--secondary a {
  color: #111827 !important;
}

/* Stats - Light mode (teal values, gray labels) */
.hero .stat-card__value {
  color: #14B8A6 !important;
}

.hero .stat-card__label,
.hero .stat-card__subtext {
  color: #6B7280 !important;
}

/* ============================================
   DARK MODE (when .theme--dark is on body)
   ============================================ */

.theme--dark .hero.section--dark {
  background: linear-gradient(135deg, #14B8A6 0%, #0F766E 100%) !important;
  color: white !important;
}

/* Hero text elements - Dark mode */
.theme--dark .hero .hero-heading {
  color: white !important;
}

.theme--dark .hero .hero-subtitle {
  color: rgba(255, 255, 255, 0.9) !important;
}

/* Primary button - Dark mode (white background, teal text) */
.theme--dark .hero .btn--primary {
  background-color: white !important;
  color: #0F766E !important;
  border-color: white !important;
}

.theme--dark .hero .btn--primary * {
  color: #0F766E !important;
}

/* Secondary button - Dark mode (outlined, WHITE text) */
.theme--dark .hero .btn--secondary {
  background-color: transparent !important;
  color: white !important;
  border-color: white !important;
}

/* Force ALL child elements in secondary button to be white in dark mode */
.theme--dark .hero .btn--secondary *,
.theme--dark .hero .btn--secondary span,
.theme--dark .hero .btn--secondary a {
  color: white !important;
}

/* Stats - Dark mode (all white) */
.theme--dark .hero .stat-card__value,
.theme--dark .hero .stat-card__label,
.theme--dark .hero .stat-card__subtext {
  color: white !important;
}
</style>

<style>
/* Brand name in nav */
.brand-name {
  color: #14B8A6 !important;
  font-weight: 700;
  font-size: 1.25rem;
  white-space: nowrap;
}

/* Optional: Change to white in dark mode */
.theme--dark .brand-name {
  color: white !important;
}
</style>

<style>
.hamburger-button {
  transition: background-color 0.2s ease;
}

.hamburger-button:hover {
  background-color: #F3F4F6 !important;
}

/* Dark mode hover */
.theme--dark .hamburger-button:hover {
  background-color: rgba(255, 255, 255, 0.1) !important;
}
</style>

<style>
/* ============================================
   MOBILE NAVIGATION - FIXED LAYOUT
   ============================================ */

/* Hamburger button - hide on desktop */
.hamburger-button {
  display: none;
}

/* Mobile navigation layout */
@media (max-width: 767px) {
  /* Nav container - horizontal layout */
  .nav-inner {
    display: flex !important;
    flex-direction: row !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 1rem 1.5rem !important;
    gap: 1rem !important;
    flex-wrap: nowrap !important;
  }
  
  /* Left side: Logo + Brand Name */
  .nav-logo-link {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    flex-shrink: 0 !important;
    order: 1 !important;
  }
  
  .nav-logo {
    width: 40px !important;
    height: 40px !important;
    flex-shrink: 0 !important;
  }
  
  .brand-name {
    font-size: 0.9rem !important;
    white-space: nowrap !important;
    order: 2 !important;
  }
  
  /* Right side: Controls container */
  .nav-inner > .theme-toggle,
  .nav-inner > .hamburger-button {
    order: 10 !important;
    flex-shrink: 0 !important;
  }
  
  /* Theme toggle button */
  .theme-toggle {
    display: flex !important;
    width: 40px !important;
    height: 40px !important;
    order: 10 !important;
  }
  
  /* Hamburger button */
  .hamburger-button {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 40px !important;
    height: 40px !important;
    cursor: pointer !important;
    border-radius: 0.5rem !important;
    transition: background-color 0.2s ease !important;
    order: 11 !important;
    flex-shrink: 0 !important;
  }
  
  .hamburger-button:hover {
    background-color: rgba(20, 184, 166, 0.1) !important;
  }
  
  .hamburger-button svg {
    width: 24px !important;
    height: 24px !important;
  }
  
  /* Hide desktop menu items */
  .nav-menu {
    display: none !important;
  }
  
  /* Hide CTA button on mobile */
  .nav-inner .btn {
    display: none !important;
  }
  
  /* Mobile menu dropdown when open */
  .nav.menu-open .nav-menu {
    display: flex !important;
    flex-direction: column !important;
    position: fixed !important;
    top: 72px !important; /* Adjust based on your nav height */
    left: 0 !important;
    right: 0 !important;
    background-color: white !important;
    padding: 1.5rem !important;
    gap: 0.5rem !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
    z-index: 1000 !important;
    max-height: calc(100vh - 72px) !important;
    overflow-y: auto !important;
  }
  
  .theme--dark .nav.menu-open .nav-menu {
    background-color: #1F2937 !important;
  }
  
  /* Menu links styling */
  .nav.menu-open .nav-menu a {
    font-size: 1.125rem !important;
    padding: 0.875rem 1rem !important;
    text-align: left !important;
    width: 100% !important;
    border-radius: 0.5rem !important;
    display: block !important;
  }
  
  .nav.menu-open .nav-menu a:hover {
    background-color: rgba(20, 184, 166, 0.1) !important;
  }
}

/* Extra small mobile - even more compact */
@media (max-width: 479px) {
  .nav-inner {
    padding: 0.75rem 1rem !important;
  }
  
  .nav-logo {
    width: 36px !important;
    height: 36px !important;
  }
  
  .brand-name {
    font-size: 0.85rem !important;
  }
  
  .theme-toggle,
  .hamburger-button {
    width: 36px !important;
    height: 36px !important;
  }
  
  .hamburger-button svg {
    width: 20px !important;
    height: 20px !important;
  }
}
</style>


<style>
/* ============================================
   AGGRESSIVE MOBILE FIX - TARGETS ALL ELEMENTS
   ============================================ */

@media (max-width: 767px) {
  /* Force all containers to fit */
  .container,
  [class*="container"],
  [class*="inner"] {
    max-width: 100% !important;
    padding-left: 1.5rem !important;
    padding-right: 1.5rem !important;
    overflow-x: hidden !important;
  }
  
  /* All sections - reduce padding */
  section,
  .section,
  [class*="section"] {
    padding-top: 3rem !important;
    padding-bottom: 3rem !important;
    overflow-x: hidden !important;
  }
  
  /* ===== HERO SECTION - FORCE FIX ===== */
  .hero,
  [class*="hero"] {
    min-height: auto !important;
    padding: 3rem 0 !important;
  }
  
  /* Hero heading */
  .hero h1,
  .hero .hero-heading,
  .hero [class*="heading"] {
    font-size: 2rem !important;
    line-height: 1.2 !important;
    margin-bottom: 1rem !important;
  }
  
  /* Hero subtitle/paragraph */
  .hero p,
  .hero .hero-subtitle,
  .hero [class*="subtitle"] {
    font-size: 1rem !important;
    line-height: 1.5 !important;
  }
  
  /* CRITICAL: Force button container to stack vertically */
  .hero > div > div,
  .hero .hero-buttons,
  .hero [class*="button"] {
    display: flex !important;
    flex-direction: column !important;
    gap: 1rem !important;
    width: 100% !important;
  }
  
  /* Force ALL buttons in hero to be full width */
  .hero .btn,
  .hero a[class*="btn"],
  .hero div[class*="btn"],
  .hero .w-button {
    width: 100% !important;
    max-width: 100% !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 1rem 1.5rem !important;
  }
  
  /* Hero stats - stack */
  .hero-stats,
  .hero [class*="stats"],
  .hero .w-dyn-items {
    display: flex !important;
    flex-direction: column !important;
    gap: 1.5rem !important;
    width: 100% !important;
    margin-top: 2rem !important;
  }
  
  /* ===== ALL GRIDS - FORCE SINGLE COLUMN ===== */
  .grid,
  .services-grid,
  .projects-grid,
  .w-dyn-items,
  [class*="grid"],
  .w-layout-grid {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 1.5rem !important;
    width: 100% !important;
  }
  
  /* Collection Lists - force single column */
  .w-dyn-list .w-dyn-items {
    grid-template-columns: 1fr !important;
  }
  
  /* ===== ALL CARDS ===== */
  .card,
  .service-card,
  .project-card,
  .w-dyn-item,
  [class*="card"] {
    width: 100% !important;
    max-width: 100% !important;
    margin-bottom: 1rem !important;
    padding: 1.5rem !important;
  }
  
  /* ===== HEADINGS ===== */
  h1 { font-size: 2rem !important; }
  h2 { font-size: 1.75rem !important; }
  h3 { font-size: 1.25rem !important; }
  h4 { font-size: 1.125rem !important; }
  
  /* Section headers */
  .section-header h2,
  .section-header__title {
    font-size: 1.875rem !important;
  }
  
  /* ===== IMAGES ===== */
  img {
    max-width: 100% !important;
    height: auto !important;
  }
  
  /* ===== FAQ SECTION ===== */
  .faq,
  .w-dropdown,
  [class*="faq"] {
    width: 100% !important;
    margin-bottom: 1rem !important;
  }
  
  /* ===== PREVENT HORIZONTAL OVERFLOW ===== */
  body,
  .page-wrapper,
  #page-wrapper {
    overflow-x: hidden !important;
    max-width: 100vw !important;
  }
  
  * {
    max-width: 100% !important;
  }
}

@media (max-width: 479px) {
  .container,
  [class*="container"] {
    padding-left: 1rem !important;
    padding-right: 1rem !important;
  }
  
  .hero h1,
  .hero-heading {
    font-size: 1.75rem !important;
  }
  
  h2 { font-size: 1.5rem !important; }
}
</style>

<style>
